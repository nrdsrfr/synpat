  "narrative": {
    "northStar": "The Patch Bench",
    "overview": "SynPat is an operator panel, used mid-task by someone with a synthesizer on the desk: a dark, flat, dense instrument-side tool of two project panes, a queue and one pinned Run bar. Few colours carry meaning (blue folder = local file, amber device = on the Syntakt, amber = planned or selected, red = blocked, green = applied). Mode: Operate.",
    "keyCharacteristics": [
      "Flat dark slate, tonal layers and hairlines; shadows only for floating overlays.",
      "Amber is the single accent and never decoration.",
      "Status is icon plus word, never colour alone.",
      "One system sans family; monospace only for the log and the name field.",
      "The Run action is always in reach."
    ],
    "rules": [
      {
        "name": "The Two Origins Rule",
        "body": "Blue folder means a file on this computer; amber device means something on the Syntakt, everywhere an object has an origin.",
        "section": "colors"
      },
      {
        "name": "The Rare Amber Rule",
        "body": "Amber marks what the user is acting on or what will change: selection, plan, primary action, device.",
        "section": "colors"
      },
      {
        "name": "The Words Beside Colour Rule",
        "body": "Red, green and amber never stand alone: each state has an icon and a word.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "No display face and no second text family.",
        "section": "typography"
      },
      {
        "name": "The Flat-Until-Floating Rule",
        "body": "In-flow surfaces have a hairline and no shadow; only menus, panels and dialogs that overlay content get a soft offset shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep amber for selection, plan, primary action and the device; use blue only for local files.",
      "Do pair every state colour with an icon and a word.",
      "Do keep grid cells the same size in every state and put new state treatments on a separate layer.",
      "Do show one primary button at a time, and keep Run reachable in the pinned bar.",
      "Do keep copy terse and exact, and name the object and the slot."
    ],
    "donts": [
      "Don't add a second type family, display fonts, gradients, glass or decorative shadows.",
      "Don't introduce a new accent colour for a feature.",
      "Don't let the 128-row device list push the workflow down.",
      "Don't pre-select a device write, offer an occupied slot, or soften the partial-write and unverified-write wording.",
      "Don't change cell size or add layout shift on state change."
    ]
  }
}
